# Copy to .env (never commit .env). Vite exposes only variables prefixed VITE_.

# Public URL of the deployed site. Used for canonical / Open Graph URLs and structured data.
VITE_SITE_URL=https://www.example.com

# Where the quote form POSTs its JSON (name, email, phone, service, size, frequency, date, area, message).
# Leave UNSET until a real endpoint exists: the form then prepares the message and the visitor sends it
# with one tap through WhatsApp or email, and the page says plainly that nothing has been sent yet.
# Any form backend that accepts a JSON POST and answers 2xx on success works (Formspree, Getform, your own).
# VITE_FORM_ENDPOINT=https://formspree.io/f/your-form-id
